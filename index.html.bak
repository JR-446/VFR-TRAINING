/* ============================================================
   4. ÉTAT & UI
   ============================================================ */
const $=id=>document.getElementById(id);
const selAir=$('selAir'), selScn=$('selScn');
let diffSel=2; // difficulté choisie (contrôle segmenté)
let S=null;              // scénario courant
let idx=0;              // index de tour
let attempts=0;        // tentatives sur le tour courant
let itemsGot=0, itemsTot=0; // score global
let running=false;
let curDiff=2, curLoad=2;       // difficulté / charge résolues (gère l'aléatoire)
let sessionQueue=[], sessionTotal=0; // file d'exercices pour le mode session

function compat(){
  const notes=[];
  if(location.protocol==='file:') notes.push('⛔ <b>Ouvert en file:// — le micro est bloqué.</b> Lancez <code>node server.js</code> (ou <code>python3 -m http.server 5500</code>) dans le dossier, puis ouvrez <b>http://localhost:5500</b>.');
  if(!('speechSynthesis' in window)) notes.push('⚠️ Synthèse vocale indisponible sur ce navigateur.');
  if(!SR) notes.push('⚠️ Reconnaissance vocale indisponible — utilisez <b>Google Chrome</b>. Une saisie clavier de secours s’activera.');
  else if(isSafari) notes.push('🧭 <b>Safari détecté</b> : son support de la reconnaissance vocale est <b>limité et instable</b>. Pour une expérience fiable, ouvrez l’app dans <b>Google Chrome</b>. En Safari, énoncez votre message d’un trait puis faites une <b>pause de ~2 s</b> ; sinon utilisez la saisie clavier.');
  else notes.push('🎙️ <b>Micro</b> : au 1<sup>er</sup> « Appuyer pour parler », Chrome demande l’autorisation → cliquez <b>Autoriser</b>. Le voyant passe à « 🎤 MICRO ACTIF ». Bruit de fond faible et casque-micro conseillés.');
  notes.push('🎧 Conseil : casque recommandé (évite que le micro capte la voix du contrôle). Ouvrez de préférence via <code>http://localhost</code> (voir README) pour autoriser le micro.');
  notes.push('🔊 <b>Voix</b> : par défaut la meilleure voix française de votre système. Pour un rendu plus naturel, installez une voix « <b>améliorée</b> » (macOS → Réglages Système → Accessibilité → Contenu énoncé → Voix → Français → ✨) : elle apparaîtra dans le menu <b>Voix</b>. (« Naturelle offline » est expérimentale et ne marche pas dans tous les navigateurs.)');
  notes.push('ℹ️ Fréquences et codes transpondeur sont <b>pédagogiques</b> — vérifiez toujours la carte VAC / l’AIP avant un vol réel.');
  notes.push('📖 Phraséologie alignée sur le <b>Manuel de phraséologie à l’usage de la CAG</b> (DGAC / ENAC, éd. 15 avril 2023) : structures MAYDAY / PAN PAN, panne radio 7600, transit VFR & VFR Spécial, circuit, AFIS.');
  $('compatNote').innerHTML=notes.join('<br>');
}
compat();

function refreshScnList(){
  const air=selAir.value;
  selScn.innerHTML='';
  const list=SCN.filter(s=>(air==='ALL'||s.air===air));
  list.forEach(s=>{
    const o=document.createElement('option');
    o.value=s.id;
    o.textContent=(air==='ALL'?`[${s.air}] `:'')+s.title;
    selScn.appendChild(o);
  });
  showBrief();
}
function showBrief(){
  const s=SCN.find(x=>x.id===selScn.value);
  $('brief').innerHTML = s ? `<b>${s.station}</b> · ${s.freq} MHz<br>${s.briefing}` : '';
}
selAir.onchange=refreshScnList;
selScn.onchange=showBrief;
refreshScnList();

// difficulté — contrôle segmenté
document.querySelectorAll('#segDiff .seg').forEach(b=>{ b.onclick=()=>{
  document.querySelectorAll('#segDiff .seg').forEach(x=>x.classList.remove('is-on'));
  b.classList.add('is-on'); diffSel=+b.dataset.v;
};});

function setAir(c){$('onair').className='onair'+(c?' '+c:'');}
function badge(t){$('statusBadge').textContent=t;}

/* ---- config résolue (gère l'aléatoire) ---- */
function resolveConfig(){
  curDiff = diffSel;
  curLoad = 2;
}
function pool(){
  const a=selAir.value;
  const p=SCN.filter(s=>a==='ALL'||s.air===a);
  return p.length?p:SCN;
}
function randomScenario(){ const p=pool(); return p[Math.floor(Math.random()*p.length)]; }

function resetPTT(){
  $('btnPTT').classList.remove('live');
  $('btnPTT').textContent='🎙️ APPUYER POUR PARLER';
  $('btnPTT').onclick=()=>{ if(!SR){ $('typeInput').focus(); return; } recActive?endListen():beginListen(); };
}

/* ---- démarrage d'un exercice (continuing=true si on enchaîne une session) ---- */
function startExercise(scn, continuing){
  S=scn; idx=0; attempts=0; running=true;
  ac();               // réveille l'audio sur le geste utilisateur
  if(Voice.mode()==='natural') Voice.init(); // précharge la voix naturelle en tâche de fond
  resolveConfig();
  $('configPanel').classList.add('hidden');
  $('commsPanel').classList.remove('hidden');
  $('scorePanel').classList.remove('hidden');
  $('typeFallback').classList.toggle('hidden', !!SR);
  $('freqLabel').textContent=`${S.station} · ${S.freq} MHz`;
  $('cfgLabel').textContent=` · niveau ${['','Débutant','Intermédiaire','Confirmé'][curDiff]}`;
  if(!continuing){ itemsGot=0; itemsTot=0; $('log').innerHTML=''; }
  threadClear();
  resetPTT();
  logLine('ls', `— Contact avec ${S.station} —`);
  sysMsg(`☎️ ${S.station} · ${S.freq} MHz — niveau ${['','Débutant','Intermédiaire','Confirmé'][curDiff]}`);
  updateMeters();
  advance();
}

/* ---- boutons de lancement ---- */
$('btnStart').onclick=()=>{
  const scn=SCN.find(x=>x.id===selScn.value); if(!scn)return;
  sessionQueue=[]; sessionTotal=0;
  startExercise(scn,false);
};
$('btnRandom').onclick=()=>{
  // n'importe quel scénario, tous espaces confondus
  sessionQueue=[]; sessionTotal=0;
  const scn=SCN[Math.floor(Math.random()*SCN.length)];
  startExercise(scn,false);
};

/* ---- fil de discussion (style iMessage) ---- */
let liveRow=null;
function threadEl(){ return document.getElementById('thread'); }
function threadClear(){ threadEl().innerHTML=''; liveRow=null; }
function threadScroll(){ const t=threadEl(); t.scrollTop=t.scrollHeight; }
function bubbleRow(side){ const r=document.createElement('div'); r.className='row '+side; threadEl().appendChild(r); return r; }
function sysMsg(html){ const r=bubbleRow('sys'); r.innerHTML='<div class="sys">'+html+'</div>'; threadScroll(); return r; }
function atcTyping(name){
  const r=bubbleRow('atc');
  r.innerHTML='<div class="tag">'+(name||'')+'</div><div class="bubble typing"><span></span><span></span><span></span></div>';
  threadScroll(); return r;
}
function atcReveal(row,text){ const b=row&&row.querySelector('.bubble'); if(!b)return; b.classList.remove('typing'); b.textContent=text; threadScroll(); }
function meBubble(text,live){ const r=bubbleRow('me'); const b=document.createElement('div'); b.className='bubble me'+(live?' live':''); b.textContent=text; r.appendChild(b); threadScroll(); return r; }
function meCaption(row,html){ if(!row)return; const c=document.createElement('div'); c.className='caption'; c.innerHTML=html; row.appendChild(c); threadScroll(); }

/* Le contrôle "parle" : points de frappe pendant la voix, texte révélé ensuite (lisible). */
async function atcSay(text){
  const row=atcTyping(S.station);
  if($('chkSub').checked) atcReveal(row,text);
  await speak(text);
  atcReveal(row,text);
  logLine('la','ATC ▸ '+text);
}

/* ---- moteur ---- */
async function advance(){
  // enchaîne toutes les transmissions du côté contrôle jusqu'au prochain tour pilote
  while(idx<S.turns.length && S.turns[idx].who!=='pilot'){
    const t=S.turns[idx];
    if(t.who==='silence'){
      badge('…'); setAir(''); sfx.hiss();
      sysMsg('📡 silence radio — aucune réponse');
      logLine('ls','(silence radio — aucune réponse)');
      await wait(2600);
    } else {
      badge('ÉCOUTEZ'); setAir('tx'); $('turnLabel').textContent='';
      await atcSay(t.text);
      setAir('');
    }
    idx++;
  }
  if(idx>=S.turns.length){ endOfScenario(); return; }
  presentPilotTurn();
}
function wait(ms){ return new Promise(r=>setTimeout(r,ms)); }
function endOfScenario(){
  if(sessionQueue.length){
    const scn=sessionQueue.shift();
    const done=sessionTotal - sessionQueue.length;
    logLine('ls',`— Exercice ${done}/${sessionTotal} : [${scn.air}] ${scn.title} —`);
    setTimeout(()=>startExercise(scn,true), 900);
  } else {
    finish(false);
  }
}

let curTurn=null;
function presentPilotTurn(){
  curTurn=S.turns[idx]; attempts=0;
  badge('À VOUS'); setAir('');
  $('pilotPrompt').textContent=curTurn.prompt;
  $('hintBox').style.display='none'; $('hintBox').innerHTML='';
  $('turnLabel').textContent=`étape ${countPilotIndex()} / ${countPilotTotal()}`;
  // indice auto en difficulté débutant
  if(curDiff===1) showHint();
  updateMeters();
}

function showHint(){
  if(curDiff===3){ return; } // pas d'indice en niveau Confirmé
  $('hintBox').style.display='block';
  $('hintBox').innerHTML='💡 Exemple de phraséologie :<br>'+curTurn.hint;
}
$('btnHint').onclick=showHint;
$('btnReplay').onclick=async()=>{
  // rejoue la dernière transmission du contrôle
  let j=idx-1; while(j>=0 && S.turns[j].who!=='atc') j--;
  if(j>=0){ setAir('tx'); badge('ÉCOUTEZ'); await speak(S.turns[j].text); setAir(''); badge('À VOUS'); }
};
$('btnSkip').onclick=()=>{ logLine('ls','(étape passée)'); itemsTot+=curTurn.expect.length; nextTurn(); };
$('btnAbort').onclick=()=>finish(true);

/* ---- reconnaissance / évaluation ---- */
let micReady=false, recErrored=false;
async function ensureMic(){
  if(micReady) return true;
  if(!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia)){ micReady=true; return true; }
  try{
    const s=await navigator.mediaDevices.getUserMedia({audio:true});
    s.getTracks().forEach(t=>t.stop()); // permission obtenue → on relâche le micro pour la reconnaissance
    micReady=true; return true;
  }catch(e){
    if(liveRow){ liveRow.remove(); liveRow=null; }
    const n=e&&e.name;
    const why = (n==='NotAllowedError'||n==='SecurityError') ? 'micro refusé/bloqué'
              : (n==='NotFoundError'||n==='DevicesNotFoundError') ? 'aucun micro détecté'
              : ('micro indisponible'+(n?' ('+n+')':''));
    sysMsg('🎙️ '+why+'. Cliquez sur le cadenas 🔒 dans la barre d’adresse → Micro → Autoriser, et ouvrez via <code>http://localhost</code>. Sinon, tapez votre réponse ci-dessous.');
    $('typeFallback').classList.remove('hidden'); try{$('typeInput').focus();}catch(_){}
    return false;
  }
}

async function beginListen(){
  if(!SR || recActive) return;
  ac();
  // Safari : démarrer DANS le geste du clic (pas d'await avant rec.start, sinon Safari bloque la reco)
  if(isSafari){ startRecognition(); return; }
  if(!(await ensureMic())) return;
  startRecognition();
}
function startRecognition(){
  sfx.beep();
  finalTranscript=''; finalAlts=''; lastHeard=''; lastAlts=''; recErrored=false; inputDone=false;
  try{ rec.start(); }
  catch(e){
    try{ rec.stop(); }catch(_){}
    sysMsg('🎙️ Impossible de démarrer la reconnaissance — réessayez, ou tapez votre réponse.');
    $('typeFallback').classList.remove('hidden');
    return;
  }
  recActive=true; badge('PARLEZ'); setAir('rx');
  $('btnPTT').classList.add('live'); $('btnPTT').textContent='🔴 ÉCOUTE… (parlez, puis marquez une pause)';
  liveRow=meBubble('🎙️ …', true);
  clearTimeout(maxTimer); maxTimer=setTimeout(finalizeInput, 15000); // sécurité si ça ne se termine jamais
}
function endListen(){ finalizeInput(); } // clic « terminer » → on évalue tout de suite
function finalizeInput(){
  if(inputDone) return; inputDone=true;              // évaluation UNE seule fois, quoi qu'il arrive
  clearTimeout(silenceTimer); clearTimeout(maxTimer);
  try{ if(rec) rec.stop(); }catch(e){}
  console.log('[VFR] finalizeInput → évaluation');
  recActive=false; setAir(''); $('btnPTT').classList.remove('live'); $('btnPTT').textContent='🎙️ APPUYER POUR PARLER';
  const said=(finalTranscript.trim()||lastHeard.trim());
  const alts=(finalAlts.trim()||lastAlts.trim()||said);
  if(said){ evaluate(said, said+' '+alts); }
  else if(!recErrored){ if(liveRow){ liveRow.remove(); liveRow=null; } sysMsg('⚠️ Aucune parole détectée — parlez plus près du micro, ou tapez votre réponse.'); $('typeFallback').classList.remove('hidden'); }
}
let lastHeard='';

if(rec){
  rec.onaudiostart=()=>{ badge('🎤 MICRO ACTIF'); if(liveRow){ const b=liveRow.querySelector('.bubble'); if(b && /^🎙️/.test(b.textContent)) b.textContent='🎤 …'; } };
  rec.onspeechstart=()=>{ badge('JE VOUS ÉCOUTE'); };
  rec.onresult=e=>{
    let interim='';
    for(let i=e.resultIndex;i<e.results.length;i++){
      const r=e.results[i];
      if(r.isFinal){
        finalTranscript += r[0].transcript+' ';
        for(let k=0;k<r.length;k++) finalAlts += r[k].transcript+' '; // toutes les hypothèses du moteur
      } else interim += r[0].transcript;
    }
    const shown=(finalTranscript+interim).trim();
    lastHeard=shown; lastAlts=(finalAlts+' '+interim).trim();
    if(liveRow){ const b=liveRow.querySelector('.bubble'); if(b) b.textContent=shown||'🎤 …'; }
    // fin de parole détectée après ~1,8 s de silence → on évalue (ne dépend PAS de onend)
    clearTimeout(silenceTimer); silenceTimer=setTimeout(finalizeInput, 1800);
  };
  rec.onerror=e=>{
    clearTimeout(silenceTimer); clearTimeout(maxTimer);
    const err=(e && e.error)||'';
    if(err==='not-allowed'||err==='service-not-allowed'){
      recErrored=true; micReady=false; if(liveRow){liveRow.remove();liveRow=null;}
      sysMsg('🎙️ Micro refusé/bloqué. Cadenas 🔒 barre d’adresse → Micro → Autoriser (et ouvrez via <code>http://localhost</code>). Sinon, tapez votre réponse.');
      $('typeFallback').classList.remove('hidden');
    } else if(err==='audio-capture'){
      recErrored=true; if(liveRow){liveRow.remove();liveRow=null;}
      sysMsg('🎙️ Aucun micro détecté, ou micro occupé par une autre application. Vérifiez votre micro puis réessayez.');
      $('typeFallback').classList.remove('hidden');
    } else if(err==='network'){
      recErrored=true; if(liveRow){liveRow.remove();liveRow=null;}
      sysMsg('🌐 Reconnaissance vocale indisponible hors-ligne : Chrome a besoin d’internet. Connectez-vous, ou tapez votre réponse.');
      $('typeFallback').classList.remove('hidden');
    }
    // 'no-speech' / 'aborted' : laissés à onend
  };
  rec.onend=()=>{ finalizeInput(); };
}

$('btnPTT').onclick=()=>{ if(!SR){ $('typeInput').focus(); return; } recActive?endListen():beginListen(); };
$('typeInput').addEventListener('keydown',e=>{ if(e.key==='Enter'&&e.target.value.trim()){ const v=e.target.value; e.target.value=''; liveRow=meBubble(v); evaluate(v);} });

function evaluate(said, matchSrc){
  const norm=normalize(matchSrc||said); // matche sur toutes les hypothèses du moteur
  logLine('lp','F-HUET ▸ '+said);
  // finalise la bulle pilote (ou en crée une)
  if(liveRow){ const b=liveRow.querySelector('.bubble'); if(b){ b.classList.remove('live'); b.textContent=said; } }
  else { liveRow=meBubble(said); }
  const myRow=liveRow; liveRow=null;

  const results=curTurn.expect.map(item=>({item, ok:item.p.some(rx=>rx.test(norm))}));
  const got=results.filter(r=>r.ok).length, tot=results.length;
  const cov=got/tot, pctTxt=Math.round(cov*100)+'%';
  const chipsHtml=results.map(r=>`<span class="chip ${r.ok?'got':'miss'}">${r.ok?'✓':'✗'} ${r.item.l}</span>`).join('');
  const cls = cov>=0.7?'ok' : cov>=0.4?'warn' : 'err';
  const mark = cov>=0.7?'✓' : cov>=0.4?'≈' : '✗';

  itemsGot+=got; itemsTot+=tot;
  meCaption(myRow, `<span class="${cls}">${mark} ${pctTxt}</span> ${chipsHtml}`);
  updateMeters();
  // le contrôle répond TOUJOURS : on enchaîne sur sa transmission suivante (comme en vraie R/T)
  setTimeout(nextTurn, 650);
}

function nextTurn(){ idx++; advance(); }

/* ---- compteurs ---- */
function countPilotTotal(){ return S.turns.filter(t=>t.who==='pilot').length; }
function countPilotIndex(){ let c=0; for(let i=0;i<=idx&&i<S.turns.length;i++) if(S.turns[i].who==='pilot')c++; return c; }
function updateMeters(){
  $('mStep').textContent=`${Math.min(countPilotIndex(),countPilotTotal())}/${countPilotTotal()}`;
  $('mItems').textContent=`${itemsGot}/${itemsTot}`;
  $('mScore').textContent = itemsTot? Math.round(itemsGot/itemsTot*100)+'%' : '—';
}
function logLine(cls,txt){ const d=document.createElement('div'); d.className='l '+cls; d.textContent=txt; $('log').appendChild(d); $('log').scrollTop=$('log').scrollHeight; }

/* ---- fin ---- */
async function finish(aborted){
  running=false; endListen(); speechSynthesis && speechSynthesis.cancel();
  badge('TERMINÉ'); setAir('');
  const pct=itemsTot?Math.round(itemsGot/itemsTot*100):0;
  const wasSession = sessionTotal>1;
  const titre = wasSession ? `Fin de la session (${sessionTotal} exercices).` : 'Fin de l’exercice.';
  let verdict = pct>=90?'Excellent — phraséologie maîtrisée ✈️' : pct>=70?'Bien — quelques collationnements à soigner' : pct>=50?'À travailler — reprenez les indices' : 'Débriefing conseillé — rejouez en Débutant';
  $('pilotPrompt').textContent='Terminé.';
  $('hintBox').style.display='none';
  sysMsg(`<b>${titre}</b><br>Score ${pct}% — ${itemsGot}/${itemsTot} éléments<br>${verdict}${aborted?' · (interrompu)':''}`);
  $('turnLabel').textContent='';
  sessionQueue=[]; sessionTotal=0;
  // boutons de fin
  $('btnPTT').textContent='↩ Retour au briefing'; $('btnPTT').classList.remove('live');
  $('btnPTT').onclick=()=>{
    $('configPanel').classList.remove('hidden');
    $('commsPanel').classList.add('hidden');
    $('scorePanel').classList.add('hidden');
    badge('EN ATTENTE');
    resetPTT();
  };
  logLine('ls',`— Score final : ${pct}% —`);
}

/* ---- thème clair / sombre (bascule + mémorisation) ---- */
function themeNow(){ return document.documentElement.getAttribute('data-theme')==='dark'?'dark':'light'; }
function applyTheme(t){
  document.documentElement.setAttribute('data-theme',t);
  try{ localStorage.setItem('vfr-theme',t); }catch(e){}
  const b=document.getElementById('themeToggle'); if(b) b.textContent = t==='dark'?'☀️':'🌙';
}
applyTheme(themeNow()); // synchronise l'icône avec le thème déjà appliqué au chargement
document.getElementById('themeToggle').onclick=()=>applyTheme(themeNow()==='dark'?'light':'dark');
</script>
</body>
</html>
